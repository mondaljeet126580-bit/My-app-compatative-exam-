            <tr><td data-label="প্রত্নস্থল">বেলন উপত্যকা</td><td data-label="রাজ্য">উত্তরপ্রদেশ</td><td data-label="কাল">নিম্ন পুরাপাষাণ</td><td data-label="প্রমাণ">চপার, চপিং প্রভৃতি অস্ত্র</td></tr>
            <tr><td data-label="প্রত্নস্থল">ডিডওয়ানা</td><td data-label="রাজ্য">রাজস্থান</td><td data-label="কাল">নিম্ন / উচ্চ</td><td data-label="প্রমাণ">পাথরের হাতিয়ার</td></tr>
            <tr><td data-label="প্রত্নস্থল">হুনাশাগী/হুশঙ্গী</td><td data-label="রাজ্য">কর্ণাটক</td><td data-label="কাল">নিম্ন পুরাপাষাণ</td><td data-label="প্রমাণ">নুড়ি-পাথরের হাতিয়ার</td></tr>
            <tr><td data-label="প্রত্নস্থল">পহলগাম</td><td data-label="রাজ্য">কাশ্মীর</td><td data-label="কাল">নিম্ন পুরাপাষাণ</td><td data-label="প্রমাণ">প্রাচীন পাথরের নিদর্শন</td></tr>
            <tr><td data-label="প্রত্নস্থল">পাটনে</td><td data-label="রাজ্য">মহারাষ্ট্র</td><td data-label="কাল">নিম্ন পুরাপাষাণ</td><td data-label="প্রমাণ">উটপাখির ডিমের খোসার প্রমাণ</td></tr>
            <tr><td data-label="প্রত্নস্থল">বোরি</td><td data-label="রাজ্য">মহারাষ্ট্র</td><td data-label="কাল">নিম্ন পুরাপাষাণ</td><td data-label="প্রমাণ">প্রাচীনতম নিম্ন পুরাপাষাণ কেন্দ্র</td></tr>
            <tr><td data-label="প্রত্নস্থল">অতিরামপক্কম</td><td data-label="রাজ্য">তামিলনাড়ু</td><td data-label="কাল">মধ্য পুরাপাষাণ</td><td data-label="প্রমাণ">ফ্লেক প্রযুক্তির অস্ত্র</td></tr>
            <tr><td data-label="প্রত্নস্থল">ইনামগাঁও</td><td data-label="রাজ্য">মহারাষ্ট্র</td><td data-label="কাল">উচ্চ পুরাপাষাণ</td><td data-label="প্রমাণ">পাথরের নিদর্শন</td></tr>
            <tr><td data-label="প্রত্নস্থল">নেওয়াসা</td><td data-label="রাজ্য">মহারাষ্ট্র</td><td data-label="কাল">উচ্চ পুরাপাষাণ</td><td data-label="প্রমাণ">পাথরের নিদর্শন</td></tr>
            <tr><td data-label="প্রত্নস্থল">ভীমবেটকা গুহা</td><td data-label="রাজ্য">মধ্যপ্রদেশ</td><td data-label="কাল">উচ্চ পুরাপাষাণ</td><td data-label="প্রমাণ">শিলাচিত্র (Rock Painting)</td></tr>
