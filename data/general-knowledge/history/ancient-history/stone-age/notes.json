<script>
(function(){
  "use strict";

  /* ============ PROGRESS BAR ============ */
  var progressBar = document.getElementById('progressBar');
  function updateProgress(){
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    progressBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, {passive:true});
  updateProgress();

  /* ============ THEME TOGGLE ============ */
  var themeBtn = document.getElementById('themeToggle');
  function applyTheme(dark){
    document.body.classList.toggle('dark', dark);
    themeBtn.textContent = dark ? '☀️' : '🌙';
    try{ localStorage.setItem('hn-theme', dark ? 'dark' : 'light'); }catch(e){}
  }
  var savedTheme = null;
  try{ savedTheme = localStorage.getItem('hn-theme'); }catch(e){}
  applyTheme(savedTheme === 'dark');
  themeBtn.addEventListener('click', function(){
    applyTheme(!document.body.classList.contains('dark'));
  });

  /* ============ FOCUS MODE ============ */
  var focusBtn = document.getElementById('focusToggle');
  focusBtn.addEventListener('click', function(){
    document.body.classList.toggle('focus');
  });

  /* ============ FONT SIZE ============ */
  var scale = 1;
  try{ var s = localStorage.getItem('hn-fontscale'); if(s) scale = parseFloat(s); }catch(e){}
  function applyScale(){
    document.documentElement.style.setProperty('--fs-scale', scale.toFixed(2));
    try{ localStorage.setItem('hn-fontscale', scale); }catch(e){}
  }
  applyScale();
  document.getElementById('fontPlus').addEventListener('click', function(){
    scale = Math.min(1.4, scale + 0.1); applyScale();
  });
  document.getElementById('fontMinus').addEventListener('click', function(){
    scale = Math.max(0.8, scale - 0.1); applyScale();
  });

  /* ============ PRINT ============ */
  document.getElementById('printBtn').addEventListener('click', function(){
    window.print();
  });

  /* ============ PYQ MCQ MOCK TEST ============ */
  var quizScoreEl = document.getElementById('quizScore');
  var pyqCards = document.querySelectorAll('.pyq-card[data-qid]');
  var totalQ = pyqCards.length;

  function currentScore(){
    return document.querySelectorAll('.pyq-card.answered .mcq-opt.correct.selected-correct').length;
  }
  function updateScore(){
    var score = document.querySelectorAll('.pyq-card[data-answered-correct="true"]').length;
    quizScoreEl.textContent = 'স্কোর: ' + score + ' / ' + totalQ;
  }

  function lockCard(card, chosenBtn){
    var opts = card.querySelectorAll('.mcq-opt');
    var isCorrect = chosenBtn.getAttribute('data-correct') === 'true';
    opts.forEach(function(opt){
      opt.disabled = true;
      opt.classList.add('disabled-opt');
      if(opt.getAttribute('data-correct') === 'true'){
        opt.classList.add('correct');
        opt.classList.remove('disabled-opt');
      }
    });
    if(!isCorrect){
      chosenBtn.classList.add('wrong');
      chosenBtn.classList.remove('disabled-opt');
    }
    card.classList.add('answered');
    card.setAttribute('data-answered-correct', isCorrect ? 'true' : 'false');
    var fb = card.querySelector('.mcq-feedback');
    var verdict = fb.querySelector('.verdict');
    fb.classList.add('show');
    fb.classList.toggle('correct-fb', isCorrect);
    fb.classList.toggle('wrong-fb', !isCorrect);
    verdict.textContent = isCorrect ? '✅ সঠিক উত্তর!' : '❌ ভুল উত্তর!';
    updateScore();
  }

  function resetCard(card){
    var opts = card.querySelectorAll('.mcq-opt');
    opts.forEach(function(opt){
      opt.disabled = false;
      opt.classList.remove('correct','wrong','disabled-opt');
    });
    card.classList.remove('answered');
    card.removeAttribute('data-answered-correct');
    var fb = card.querySelector('.mcq-feedback');
    fb.classList.remove('show','correct-fb','wrong-fb');
    updateScore();
  }

  pyqCards.forEach(function(card){
    var opts = card.querySelectorAll('.mcq-opt');
    opts.forEach(function(opt){
      opt.addEventListener('click', function(){
        if(card.classList.contains('answered')) return;
        lockCard(card, opt);
      });
    });
    var resetLink = card.querySelector('.mcq-reset-link');
    resetLink.addEventListener('click', function(){
      resetCard(card);
    });
  });

  document.getElementById('resetQuizBtn').addEventListener('click', function(){
    pyqCards.forEach(resetCard);
  });

  updateScore();

  /* ============ SITE EXPLORER SEARCH ============ */
  var siteSearch = document.getElementById('siteSearch');
  var siteCards = document.querySelectorAll('.site-card');
  var siteNoResult = document.getElementById('siteNoResult');
  siteSearch.addEventListener('input', function(){
    var q = siteSearch.value.trim().toLowerCase();
    var anyVisible = false;
    siteCards.forEach(function(card){
      var hay = card.getAttribute('data-search') + ' ' + card.textContent.toLowerCase();
      var match = q === '' || hay.toLowerCase().indexOf(q) !== -1;
      card.style.display = match ? '' : 'none';
      if(match) anyVisible = true;
    });
    siteNoResult.style.display = anyVisible ? 'none' : 'block';
  });

  /* ============ GLOBAL SEARCH (highlight + scroll) ============ */
  var searchBox = document.getElementById('searchBox');
  var mainContent = document.getElementById('mainContent');
  var searchTimeout;
  var lastMarks = [];

  function clearMarks(){
    lastMarks.forEach(function(mark){
      var parent = mark.parentNode;
      if(!parent) return;
      parent.replaceChild(document.createTextNode(mark.textContent), mark);
      parent.normalize();
    });
    lastMarks = [];
  }

  function walkAndHighlight(root, query){
    var found = [];
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function(node){
        if(!node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        if(node.parentNode && (node.parentNode.tagName === 'SCRIPT' || node.parentNode.tagName === 'STYLE')) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var nodes = [];
    var n;
    while((n = walker.nextNode())) nodes.push(n);

    nodes.forEach(function(node){
      var text = node.nodeValue;
      var lower = text.toLowerCase();
      var idx = lower.indexOf(query);
      if(idx === -1) return;
      var frag = document.createDocumentFragment();
      var cursor = 0;
      var i = idx;
      while(i !== -1){
        frag.appendChild(document.createTextNode(text.slice(cursor, i)));
        var mark = document.createElement('mark');
        mark.className = 'search-hit';
        mark.textContent = text.slice(i, i + query.length);
        frag.appendChild(mark);
        found.push(mark);
        cursor = i + query.length;
        i = lower.indexOf(query, cursor);
      }
      frag.appendChild(document.createTextNode(text.slice(cursor)));
      node.parentNode.replaceChild(frag, node);
    });
    return found;
  }

  searchBox.addEventListener('input', function(){
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(function(){
      clearMarks();
      var q = searchBox.value.trim().toLowerCase();
      if(q.length < 2) return;
      lastMarks = walkAndHighlight(mainContent, q);
      if(lastMarks.length){
        lastMarks[0].scrollIntoView({behavior:'smooth', block:'center'});
      }
    }, 250);
  });

  /* ============ SECTION FADE-IN ON SCROLL ============ */
  if('IntersectionObserver' in window){
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.style.animationPlayState = 'running';
          obs.unobserve(entry.target);
        }
      });
    }, {threshold:0.05});
    document.querySelectorAll('.section').forEach(function(sec){
      obs.observe(sec);
    });
  }

})();
</script>
</body>
</html>
